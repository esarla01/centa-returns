# Copy to .env and fill in. Never commit the real .env file.

# Application
FLASK_DEBUG=False
PORT=5000
FRONTEND_URL=http://localhost:3000
# Address used for links in invitation and password-reset emails
EMAIL_LINK_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# Database
DATABASE_URI=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# JWT
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRES=1
JWT_TOKEN_LOCATION=cookies
JWT_ACCESS_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=None
JWT_COOKIE_CSRF_PROTECT=False

# Email (Resend)
RESEND_API_KEY=
# Set to True to email the next team whenever a stage is completed
STAGE_EMAILS_ENABLED=False

# First admin user, created only when the database has no roles yet
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
